#Область ПоискНоменклатурыИКонтрагентов

Функция НоменклатураПоSKU(SKU)
	// SKU = штрихкод (основной путь InterTex) или код номенклатуры (fallback).
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШК", SKU);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШКРег.Владелец        КАК Номенклатура,
	|	ШКРег.Характеристика  КАК Характеристика
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК ШКРег
	|ГДЕ
	|	ШКРег.Штрихкод = &ШК";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура("Номенклатура, Характеристика", Выборка.Номенклатура, Выборка.Характеристика);
		Возврат Результат;
	КонецЕсли;

	НомПоКоду = Справочники.Номенклатура.НайтиПоКоду(SKU);
	Если ЗначениеЗаполнено(НомПоКоду) Тогда
		Возврат Новый Структура("Номенклатура, Характеристика", НомПоКоду, Неопределено);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция SKUПоНоменклатуре(Номенклатура, Характеристика)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ном", Номенклатура);
	Запрос.УстановитьПараметр("Хар", ?(Характеристика = Неопределено, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Характеристика));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 ШК.Штрихкод КАК Штрихкод
	|ИЗ РегистрСведений.Штрихкоды КАК ШК
	|ГДЕ ШК.Владелец = &Ном И ШК.Характеристика = &Хар";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Штрихкод);
	КонецЕсли;
	Возврат СокрЛП(Номенклатура.Код);
КонецФункции

Функция НайтиКонтрагентаПоКонтакту(Значение, ЭтоТелефон)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Типовой регистр контактной информации УТ 10.3/УТП.
	// ПРОВЕРИТЬ(УТП): имя регистра (КонтактнаяИнформация) и его измерения.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Значение", "%" + Значение + "%");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 КИ.Объект КАК Объект
	|ИЗ РегистрСведений.КонтактнаяИнформация КАК КИ
	|ГДЕ КИ.Представление ПОДОБНО &Значение
	|  И КИ.Объект ССЫЛКА Справочник.Контрагенты";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Объект;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ЗаписатьКонтактнуюИнформацию(КонтрагентСсылка, Телефоны, Почты)
	// ПРОВЕРИТЬ(УТП): запись в РегистрСведений.КонтактнаяИнформация — типы
	// (Телефон/АдресЭлектроннойПочты), виды КИ для Контрагентов.
	// Заполняется специалистом 1С по типовым процедурам базы.
КонецПроцедуры

Функция НормализоватьТелефон(Телефон)
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	// Последние 9 цифр (без кода страны) для устойчивого поиска.
	Если СтрДлина(Цифры) > 9 Тогда
		Цифры = Прав(Цифры, 9);
	КонецЕсли;
	Возврат Цифры;
КонецФункции

#КонецОбласти

#Область Резервирование

Функция ПроверитьДоступность(ДокЗаказ)
	Дефициты = Новый Массив;
	Для Каждого СтрокаТЧ Из ДокЗаказ.Товары Цикл
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ном", СтрокаТЧ.Номенклатура);
		Запрос.УстановитьПараметр("Склад", ДокЗаказ.Склад);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Ост.КоличествоОстаток), 0) КАК Количество
		|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура = &Ном И Склад = &Склад) КАК Ост";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Доступно = Выборка.Количество - ЗарезервированоПоНоменклатуре(СтрокаТЧ.Номенклатура, ДокЗаказ.Склад);
		Если Доступно < СтрокаТЧ.Количество Тогда
			Дефицит = Новый Структура;
			Дефицит.Вставить("sku", SKUПоНоменклатуре(СтрокаТЧ.Номенклатура, Неопределено));
			Дефицит.Вставить("requested", СтрокаТЧ.Количество);
			Дефицит.Вставить("available", Доступно);
			Дефициты.Добавить(Дефицит);
		КонецЕсли;
	КонецЦикла;
	Возврат Дефициты;
КонецФункции

Функция ЗарезервированоПоНоменклатуре(Номенклатура, Склад)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ном", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.Текст =
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(Рез.КоличествоОстаток), 0) КАК Количество
	|ИЗ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Номенклатура = &Ном И Склад = &Склад) КАК Рез";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;
КонецФункции

Функция ОстаткиПоЗаказу(ЗаказСсылка)
	Массив = Новый Массив;
	Для Каждого СтрокаТЧ Из ЗаказСсылка.Товары Цикл
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ном", СтрокаТЧ.Номенклатура);
		Запрос.УстановитьПараметр("Склад", ЗаказСсылка.Склад);
		Запрос.Текст =
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Ост.КоличествоОстаток), 0) КАК Количество
		|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура = &Ном И Склад = &Склад) КАК Ост";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Резерв = ЗарезервированоПоНоменклатуре(СтрокаТЧ.Номенклатура, ЗаказСсылка.Склад);
		Ряд = Новый Структура;
		Ряд.Вставить("sku", SKUПоНоменклатуре(СтрокаТЧ.Номенклатура, Неопределено));
		Ряд.Вставить("warehouseGuid", XMLСтрока(ЗаказСсылка.Склад.УникальныйИдентификатор()));
		Ряд.Вставить("quantity", Выборка.Количество);
		Ряд.Вставить("reserved", Резерв);
		Ряд.Вставить("available", Выборка.Количество - Резерв);
		Массив.Добавить(Ряд);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Процедура СократитьТЧВозврата(ДокВозврата, ПозицииВозврата)
	// Оставить в ТЧ только позиции возврата с их количеством.
	ИндексыКУдалению = Новый Массив;
	Для Каждого СтрокаТЧ Из ДокВозврата.Товары Цикл
		SKU = SKUПоНоменклатуре(СтрокаТЧ.Номенклатура, Неопределено);
		Найдено = Ложь;
		Для Каждого Позиция Из ПозицииВозврата Цикл
			Если ЗначениеАргумента(Позиция, "sku", "") = SKU Тогда
				СтрокаТЧ.Количество = ЗначениеАргумента(Позиция, "quantity", СтрокаТЧ.Количество);
				// ПРОВЕРИТЬ(УТП): пересчёт Суммы/НДС при изменении количества.
				СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найдено Тогда
			ИндексыКУдалению.Добавить(ДокВозврата.Товары.Индекс(СтрокаТЧ));
		КонецЕсли;
	КонецЦикла;
	// Удаляем с конца, чтобы не сместить индексы.
	Для Индекс = 1 По ИндексыКУдалению.Количество() Цикл
		ДокВозврата.Товары.Удалить(ИндексыКУдалению[ИндексыКУдалению.Количество() - Индекс]);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеJSONИОтветы

Функция ПрочитатьJSONСтроку(СтрокаJSON)
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение, Истина); // Истина = в Соответствие
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ЗаписатьJSONВСтроку(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ОтветУспех(Данные)
	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", Данные);
	Возврат ЗаписатьJSONВСтроку(Ответ);
КонецФункции

Функция ОтветОшибка(Код, Сообщение, Повторяемая, Детали)
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Ошибка.Вставить("retryable", Повторяемая);
	Ошибка.Вставить("details", ?(Детали = Неопределено, Новый Массив, Детали));
	Ответ = Новый Структура;
	Ответ.Вставить("success", Ложь);
	Ответ.Вставить("error", Ошибка);
	Возврат ЗаписатьJSONВСтроку(Ответ);
КонецФункции

// Бизнес-ошибка прерывает операцию; диспетчер вернёт корректный JSON-конверт.
Процедура ВызватьБизнесОшибку(Код, Сообщение, Повторяемая, Детали = Неопределено)
	JSONОшибки = ОтветОшибка(Код, Сообщение, Повторяемая, Детали);
	ВызватьИсключение "##BIZ##" + JSONОшибки + "##ENDBIZ##";
КонецПроцедуры

Функция ИзвлечьJSONБизнесОшибки(ТекстОшибки, ПозицияМаркера)
	Начало = ПозицияМаркера + СтрДлина("##BIZ##");
	Конец = СтрНайти(ТекстОшибки, "##ENDBIZ##");
	Возврат Сред(ТекстОшибки, Начало, Конец - Начало);
КонецФункции

Процедура ИнициализироватьКодыОшибок()
	Если КодыОшибок = Неопределено Тогда
		КодыОшибок = Новый Соответствие;
	КонецЕсли;
КонецПроцедуры

Функция ЗначениеАргумента(Коллекция, Ключ, ПоУмолчанию)
	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Значение = Коллекция.Получить(Ключ);
		Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Коллекция.Свойство(Ключ, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ОписаниеДокумента(Ссылка)
	Ответ = Новый Структура;
	Ответ.Вставить("guid", XMLСтрока(Ссылка.УникальныйИдентификатор()));
	Ответ.Вставить("number", СокрЛП(Ссылка.Номер));
	Ответ.Вставить("date", ФорматДатыISO(Ссылка.Дата));
	Ответ.Вставить("posted", Ссылка.Проведен);
	Возврат Ответ;
КонецФункции

Функция ОписаниеДокументаБезЗаписи(ДокОбъект)
	// Для dryRun: документ не записан, ссылки нет.
	Ответ = Новый Структура;
	Ответ.Вставить("guid", "");
	Ответ.Вставить("number", "(dry-run)");
	Ответ.Вставить("date", ФорматДатыISO(ТекущаяДата()));
	Ответ.Вставить("posted", Ложь);
	Возврат Ответ;
КонецФункции

Функция РезультатКонтрагента(Ссылка, Создан, СовпалоПо)
	Ответ = Новый Структура;
	Ответ.Вставить("guid", XMLСтрока(Ссылка.УникальныйИдентификатор()));
	Ответ.Вставить("created", Создан);
	Ответ.Вставить("matchedBy", СовпалоПо);
	Возврат Ответ;
КонецФункции

Функция ФорматДатыISO(Дата)
	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции

Функция ДатаИзISO(Строка)
	Если ПустаяСтрока(Строка) Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Лев(Строка, 19));
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

