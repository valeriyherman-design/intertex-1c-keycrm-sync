// ============================================================================
// ИнтеграцияKeyCRM — модуль объекта внешней обработки (.epf)
// Конфигурация: Управление торговым предприятием для Украины, ред. 1.2 (1.2.35.1)
// Платформа: 8.3.18+ (режим совместимости 8.2 допустим — JSON-объекты платформы
// доступны независимо от режима совместимости).
//
// Вызывается интеграционным сервисом через COM (V83.COMConnector):
//   Обработка.ВыполнитьОперацию(Операция, АргументыJSON) -> СтрокаJSON
//
// Контракт операций, полей и кодов ошибок: handover-1c/05_API_CONTRACT.md.
// Все операции записи идемпотентны. Валюта — только USD (DEC-008).
//
// Метки "// ПРОВЕРИТЬ(УТП):" — места, где специалист 1С обязан сверить имена
// метаданных/реквизитов с фактической базой (см. handover-1c/08_TASK...).
// ============================================================================

Перем КодыОшибок; // соответствие код -> повторяемость

#Область ТочкаВхода

// Единственная экспортная функция — диспетчер операций.
Функция ВыполнитьОперацию(Знач Операция, Знач АргументыJSON) Экспорт

	ИнициализироватьКодыОшибок();

	Попытка
		Аргументы = ПрочитатьJSONСтроку(АргументыJSON);

		Если Операция = "health" Тогда
			Данные = ОперацияHealth();
		ИначеЕсли Операция = "warehouses" Тогда
			Данные = ОперацияСклады();
		ИначеЕсли Операция = "products" Тогда
			Данные = ОперацияТовары(Аргументы);
		ИначеЕсли Операция = "stocks" Тогда
			Данные = ОперацияОстатки(Аргументы);
		ИначеЕсли Операция = "upsert_customer" Тогда
			Данные = ОперацияКонтрагент(Аргументы);
		ИначеЕсли Операция = "upsert_order" Тогда
			Данные = ОперацияЗаказ(Аргументы);
		ИначеЕсли Операция = "reserve" Тогда
			Данные = ОперацияРезерв(Аргументы);
		ИначеЕсли Операция = "unreserve" Тогда
			Данные = ОперацияСнятьРезерв(Аргументы);
		ИначеЕсли Операция = "ship" Тогда
			Данные = ОперацияРеализация(Аргументы);
		ИначеЕсли Операция = "create_return" Тогда
			Данные = ОперацияВозврат(Аргументы);
		ИначеЕсли Операция = "register_payment" Тогда
			Данные = ОперацияОплата(Аргументы);
		ИначеЕсли Операция = "order_state" Тогда
			Данные = ОперацияСостояниеЗаказа(Аргументы);
		ИначеЕсли Операция = "transfers" Тогда
			Данные = ОперацияПеремещения(Аргументы);
		Иначе
			Возврат ОтветОшибка("VALIDATION_ERROR", "Неизвестная операция: " + Операция, Ложь, Неопределено);
		КонецЕсли;

		Возврат ОтветУспех(Данные);

	Исключение
		Инфо = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(Инфо);
		// Бизнес-ошибка, брошенная через ВызватьБизнесОшибку()?
		ПозицияМаркера = СтрНайти(ТекстОшибки, "##BIZ##");
		Если ПозицияМаркера > 0 Тогда
			JSONОшибки = ИзвлечьJSONБизнесОшибки(ТекстОшибки, ПозицияМаркера);
			Возврат JSONОшибки;
		КонецЕсли;
		Возврат ОтветОшибка("INTERNAL_ERROR", КраткоеПредставлениеОшибки(Инфо), Истина, Неопределено);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Операции

Функция ОперацияHealth()
	Ответ = Новый Структура;
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("config", Метаданные.Синоним + " " + Метаданные.Версия);
	Ответ.Вставить("extension_version", "0.1.0");
	Ответ.Вставить("time", ФорматДатыISO(ТекущаяДата()));
	Возврат Ответ;
КонецФункции

Функция ОперацияСклады()
	Массив = Новый Массив;
	Выборка = Справочники.Склады.Выбрать(); // ПРОВЕРИТЬ(УТП): имя справочника складов
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		Склад = Новый Структура;
		Склад.Вставить("guid", XMLСтрока(Выборка.Ссылка.УникальныйИдентификатор()));
		Склад.Вставить("code", СокрЛП(Выборка.Код));
		Склад.Вставить("name", СокрЛП(Выборка.Наименование));
		Склад.Вставить("is_active", НЕ Выборка.ПометкаУдаления);
		Массив.Добавить(Склад);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ОперацияТовары(Аргументы)
	НомерСтраницы = ЗначениеАргумента(Аргументы, "page", 1);
	РазмерСтраницы = ЗначениеАргумента(Аргументы, "limit", 100);

	// Каталог: номенклатура + характеристики + штрихкоды + цены (срез последних).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.Ссылка              КАК Ссылка,
	|	Ном.Код                 КАК Код,
	|	Ном.Наименование        КАК Наименование,
	|	Ном.Родитель.Наименование КАК Категория,
	|	Ном.ЕдиницаХраненияОстатков.Наименование КАК Единица,
	|	Ном.ПометкаУдаления     КАК Архив
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	НЕ Ном.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО Ном.Код";
	// ПРОВЕРИТЬ(УТП): ЕдиницаХраненияОстатков — типовой реквизит УТ 10.3/УТП.

	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
	ВсегоЗаписей = ТаблицаНоменклатуры.Количество();

	Начало = (НомерСтраницы - 1) * РазмерСтраницы;
	Массив = Новый Массив;
	Индекс = Начало;
	Пока Индекс < Мин(Начало + РазмерСтраницы, ВсегоЗаписей) Цикл
		Строка = ТаблицаНоменклатуры[Индекс];
		Товар = Новый Структура;
		Товар.Вставить("guid", XMLСтрока(Строка.Ссылка.УникальныйИдентификатор()));
		Товар.Вставить("code", СокрЛП(Строка.Код));
		Товар.Вставить("name", СокрЛП(Строка.Наименование));
		Товар.Вставить("category", Строка(Строка.Категория));
		Товар.Вставить("unit", Строка(Строка.Единица));
		// Дробность: метры/кг — дробные, штуки — целые.
		// ПРОВЕРИТЬ(УТП): признак целочисленности единицы измерения (если ведётся).
		ЕдиницаНижн = НРег(Строка(Строка.Единица));
		Товар.Вставить("unit_allows_fraction", ЕдиницаНижн = "м" ИЛИ СтрНайти(ЕдиницаНижн, "метр") > 0);
		Товар.Вставить("is_archived", Строка.Архив);
		Товар.Вставить("variants", ВариантыНоменклатуры(Строка.Ссылка));
		Массив.Добавить(Товар);
		Индекс = Индекс + 1;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("data", Массив);
	Ответ.Вставить("pageNumber", НомерСтраницы);
	Ответ.Вставить("limit", РазмерСтраницы);
	Ответ.Вставить("total", ВсегоЗаписей);
	Возврат Ответ;
КонецФункции

Функция ВариантыНоменклатуры(НоменклатураСсылка)
	// Характеристики + штрихкоды + цены по каждой характеристике (или без неё).
	Варианты = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ном", НоменклатураСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШК.Штрихкод        КАК Штрихкод,
	|	ШК.Характеристика  КАК Характеристика
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК ШК
	|ГДЕ
	|	ШК.Владелец = &Ном";
	// ПРОВЕРИТЬ(УТП): регистр Штрихкоды, измерения Владелец/Характеристика —
	// в УТП/УТ 10.3 обычно РегистрСведений.Штрихкоды (Владелец, Характеристика, Штрихкод).

	ЕстьХотяБыОдин = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЕстьХотяБыОдин = Истина;
		Вариант = Новый Структура;
		ХарСсылка = Выборка.Характеристика;
		Если ЗначениеЗаполнено(ХарСсылка) Тогда
			Вариант.Вставить("characteristicGuid", XMLСтрока(ХарСсылка.УникальныйИдентификатор()));
			Вариант.Вставить("characteristic", Строка(ХарСсылка));
		Иначе
			Вариант.Вставить("characteristicGuid", Неопределено);
			Вариант.Вставить("characteristic", Неопределено);
		КонецЕсли;
		// SKU = штрихкод (в KeyCRM InterTex SKU хранит внутренние штрихкоды 2000000…)
		Вариант.Вставить("sku", СокрЛП(Выборка.Штрихкод));
		Вариант.Вставить("barcode", СокрЛП(Выборка.Штрихкод));
		Вариант.Вставить("purchasedPrice", 0);
		Вариант.Вставить("prices", ЦеныНоменклатуры(НоменклатураСсылка, ХарСсылка));
		Варианты.Добавить(Вариант);
	КонецЦикла;

	Если НЕ ЕстьХотяБыОдин Тогда
		// Товар без штрихкода: SKU = код номенклатуры (fallback, см. mapping-таблицу).
		Вариант = Новый Структура;
		Вариант.Вставить("characteristicGuid", Неопределено);
		Вариант.Вставить("characteristic", Неопределено);
		Вариант.Вставить("sku", СокрЛП(НоменклатураСсылка.Код));
		Вариант.Вставить("barcode", Неопределено);
		Вариант.Вставить("purchasedPrice", 0);
		Вариант.Вставить("prices", ЦеныНоменклатуры(НоменклатураСсылка, Неопределено));
		Варианты.Добавить(Вариант);
	КонецЕсли;

	Возврат Варианты;
КонецФункции

Функция ЦеныНоменклатуры(НоменклатураСсылка, ХарактеристикаСсылка)
	Цены = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ном", НоменклатураСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.ТипЦен.Наименование КАК ТипЦен,
	|	Цены.Цена                КАК Цена,
	|	Цены.Валюта.Наименование КАК Валюта
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Ном) КАК Цены";
	// ПРОВЕРИТЬ(УТП): измерение Характеристика в ЦеныНоменклатуры (если ведётся —
	// добавить отбор по &Характеристика).

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаЦены = Новый Структура;
		СтрокаЦены.Вставить("priceType", Строка(Выборка.ТипЦен));
		СтрокаЦены.Вставить("price", Выборка.Цена);
		СтрокаЦены.Вставить("currency", Строка(Выборка.Валюта));
		Цены.Добавить(СтрокаЦены);
	КонецЦикла;
	Возврат Цены;
КонецФункции

Функция ОперацияОстатки(Аргументы)
	СкладGuid = ЗначениеАргумента(Аргументы, "warehouseGuid", Неопределено);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура            КАК Номенклатура,
	|	Остатки.Характеристика          КАК Характеристика,
	|	Остатки.Склад                   КАК Склад,
	|	Остатки.КоличествоОстаток       КАК Количество,
	|	ЕСТЬNULL(Резервы.КоличествоОстаток, 0) КАК Резерв
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, %УсловиеСклада%) КАК Остатки
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, %УсловиеСклада%) КАК Резервы
	|		ПО Остатки.Номенклатура = Резервы.Номенклатура
	|		И Остатки.Характеристика = Резервы.Характеристика
	|		И Остатки.Склад = Резервы.Склад";
	// ПРОВЕРИТЬ(УТП): имена регистров ТоварыНаСкладах / ТоварыВРезервеНаСкладах
	// и наличие измерения Характеристика (если нет — убрать из соединения).

	Если СкладGuid <> Неопределено Тогда
		Склад = Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(СкладGuid));
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеСклада%", "Склад = &Склад");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеСклада%", "");
	КонецЕсли;

	Массив = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		SKU = SKUПоНоменклатуре(Выборка.Номенклатура, Выборка.Характеристика);
		Если SKU = "" Тогда
			Продолжить; // товар без идентификатора не синхронизируем (лог на стороне сервиса)
		КонецЕсли;
		Ряд = Новый Структура;
		Ряд.Вставить("sku", SKU);
		Ряд.Вставить("warehouseGuid", XMLСтрока(Выборка.Склад.УникальныйИдентификатор()));
		Ряд.Вставить("quantity", Выборка.Количество);
		Ряд.Вставить("reserved", Выборка.Резерв);
		Ряд.Вставить("available", Выборка.Количество - Выборка.Резерв);
		Массив.Добавить(Ряд);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("data", Массив);
	Ответ.Вставить("pageNumber", 1);
	Ответ.Вставить("limit", Массив.Количество());
	Ответ.Вставить("total", Массив.Количество());
	Возврат Ответ;
КонецФункции

Функция ОперацияКонтрагент(Аргументы)
	Запрос = ЗначениеАргумента(Аргументы, "request", Неопределено);
	Если Запрос = Неопределено Тогда
		ВызватьБизнесОшибку("VALIDATION_ERROR", "Отсутствует request", Ложь);
	КонецЕсли;
	BuyerId = Формат(ЗначениеАргумента(Запрос, "keycrmBuyerId", 0), "ЧГ=0");
	ИмяПолное = ЗначениеАргумента(Запрос, "fullName", "");
	Телефоны = ЗначениеАргумента(Запрос, "phones", Новый Массив);
	Почты = ЗначениеАргумента(Запрос, "emails", Новый Массив);

	// 1. Поиск по внешнему ID KeyCRM (механизм свойств).
	Найденный = НайтиПоВнешнемуИД("buyer", BuyerId);
	Если Найденный <> Неопределено Тогда
		Возврат РезультатКонтрагента(Найденный, Ложь, "keycrm_id");
	КонецЕсли;

	// 2. Поиск дублей по телефону.
	Для Каждого Телефон Из Телефоны Цикл
		Найденный = НайтиКонтрагентаПоКонтакту(НормализоватьТелефон(Телефон), Истина);
		Если Найденный <> Неопределено Тогда
			ЗаписатьВнешнийИД("buyer", BuyerId, Найденный);
			Возврат РезультатКонтрагента(Найденный, Ложь, "phone");
		КонецЕсли;
	КонецЦикла;

	// 3. Поиск по email.
	Для Каждого Почта Из Почты Цикл
		Найденный = НайтиКонтрагентаПоКонтакту(НРег(СокрЛП(Почта)), Ложь);
		Если Найденный <> Неопределено Тогда
			ЗаписатьВнешнийИД("buyer", BuyerId, Найденный);
			Возврат РезультатКонтрагента(Найденный, Ложь, "email");
		КонецЕсли;
	КонецЦикла;

	// 4. Создание.
	НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Наименование = ИмяПолное;
	НовыйКонтрагент.НаименованиеПолное = ИмяПолное;
	// ПРОВЕРИТЬ(УТП): обязательные реквизиты Контрагента (ЮрФизЛицо, папка/группа,
	// главный договор — в УТ 10.3 договор создаётся автоматически при записи).
	НовыйКонтрагент.Записать();

	ЗаписатьКонтактнуюИнформацию(НовыйКонтрагент.Ссылка, Телефоны, Почты);
	ЗаписатьВнешнийИД("buyer", BuyerId, НовыйКонтрагент.Ссылка);

	Возврат РезультатКонтрагента(НовыйКонтрагент.Ссылка, Истина, "none");
КонецФункции

Функция ОперацияЗаказ(Аргументы)
	Запрос = ЗначениеАргумента(Аргументы, "request", Неопределено);
	DryRun = ЗначениеАргумента(Аргументы, "dryRun", Ложь);
	ЗаказId = Формат(ЗначениеАргумента(Запрос, "keycrmOrderId", 0), "ЧГ=0");
	Валюта = ЗначениеАргумента(Запрос, "currency", "");

	Если Валюта <> "USD" Тогда
		ВызватьБизнесОшибку("CURRENCY_NOT_SUPPORTED",
			"Валюта " + Валюта + " не поддерживается (только USD, DEC-008). Prom пересчитывается вручную.", Ложь);
	КонецЕсли;

	Позиции = ЗначениеАргумента(Запрос, "items", Новый Массив);
	Если Позиции.Количество() = 0 Тогда
		ВызватьБизнесОшибку("VALIDATION_ERROR", "Пустой состав заказа", Ложь);
	КонецЕсли;

	КонтрагентGuid = ЗначениеАргумента(Запрос, "customerGuid", "");
	СкладGuid = ЗначениеАргумента(Запрос, "warehouseGuid", "");
	Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(КонтрагентGuid));
	Склад = Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(СкладGuid));
	Если Контрагент.ПолучитьОбъект() = Неопределено Тогда
		ВызватьБизнесОшибку("CUSTOMER_NOT_FOUND", "Контрагент " + КонтрагентGuid + " не найден", Ложь);
	КонецЕсли;
	Если Склад.ПолучитьОбъект() = Неопределено Тогда
		ВызватьБизнесОшибку("WAREHOUSE_NOT_FOUND", "Склад " + СкладGuid + " не найден", Ложь);
	КонецЕсли;

	// Идемпотентность: один заказ KeyCRM = один ЗаказПокупателя.
	Существующий = НайтиПоВнешнемуИД("order", ЗаказId);

	НачатьТранзакцию();
	Попытка
		Если Существующий = Неопределено Тогда
			Док = Документы.ЗаказПокупателя.СоздатьДокумент();
			Док.Дата = ТекущаяДата();
			// ПРОВЕРИТЬ(УТП): обязательные реквизиты ЗаказаПокупателя:
			// Организация, ДоговорКонтрагента, ВалютаДокумента, ТипЦен, СтруктурнаяЕдиница...
			Док.Контрагент = Контрагент;
			Док.Склад = Склад;
		Иначе
			Док = Существующий.ПолучитьОбъект();
			Если БылаРеализация(ЗаказId) Тогда
				ВызватьБизнесОшибку("ORDER_MODIFIED", "Заказ уже реализован, изменение состава запрещено", Ложь);
			КонецЕсли;
			Док.Товары.Очистить();
		КонецЕсли;

		Док.Комментарий = "KeyCRM #" + ЗаказId + " | " + ЗначениеАргумента(Запрос, "comment", "");

		Для Каждого Позиция Из Позиции Цикл
			SKU = ЗначениеАргумента(Позиция, "sku", "");
			НайденоСКУ = НоменклатураПоSKU(SKU);
			Если НайденоСКУ = Неопределено Тогда
				ВызватьБизнесОшибку("SKU_NOT_FOUND", "SKU не сопоставлен: " + SKU, Ложь);
			КонецЕсли;
			НоваяСтрока = Док.Товары.Добавить();
			НоваяСтрока.Номенклатура = НайденоСКУ.Номенклатура;
			Если ЗначениеЗаполнено(НайденоСКУ.Характеристика) Тогда
				НоваяСтрока.ХарактеристикаНоменклатуры = НайденоСКУ.Характеристика;
				// ПРОВЕРИТЬ(УТП): имя колонки характеристики в ТЧ Товары.
			КонецЕсли;
			НоваяСтрока.Количество = ЗначениеАргумента(Позиция, "quantity", 0);
			НоваяСтрока.Цена = ЗначениеАргумента(Позиция, "price", 0);
			НоваяСтрока.Сумма = ЗначениеАргумента(Позиция, "sum", НоваяСтрока.Количество * НоваяСтрока.Цена);
			// ПРОВЕРИТЬ(УТП): ЕдиницаИзмерения/Коэффициент в ТЧ (заполнить из номенклатуры).
		КонецЦикла;

		Если DryRun Тогда
			ОтменитьТранзакцию();
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
			ЗаписатьВнешнийИД("order", ЗаказId, Док.Ссылка);
			ЗаписатьВнешнийИД("order_checksum", ЗаказId, ЗначениеАргумента(Запрос, "itemsChecksum", ""));
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Возврат ОписаниеДокумента(Док.Ссылка);
КонецФункции

Функция ОперацияРезерв(Аргументы)
	ЗаказId = Формат(ЗначениеАргумента(Аргументы, "keycrmOrderId", 0), "ЧГ=0");
	DryRun = ЗначениеАргумента(Аргументы, "dryRun", Ложь);

	ЗаказСсылка = НайтиПоВнешнемуИД("order", ЗаказId);
	Если ЗаказСсылка = Неопределено Тогда
		ВызватьБизнесОшибку("ORDER_NOT_FOUND", "Заказ KeyCRM #" + ЗаказId + " не найден в 1С", Ложь);
	КонецЕсли;

	Док = ЗаказСсылка.ПолучитьОбъект();

	// Идемпотентность: заказ уже проведён с резервом — просто вернуть остатки.
	Если Док.Проведен Тогда
		Возврат ОстаткиПоЗаказу(ЗаказСсылка);
	КонецЕсли;

	// Проверка доступности ВСЕХ позиций до проведения (без частичных резервов).
	Дефициты = ПроверитьДоступность(Док);
	Если Дефициты.Количество() > 0 Тогда
		ВызватьБизнесОшибку("INSUFFICIENT_STOCK", "Недостатньо залишку", Ложь, Дефициты);
	КонецЕсли;

	Если НЕ DryRun Тогда
		// Резервирование: типовое проведение ЗаказаПокупателя с размещением в резерв.
		// ПРОВЕРИТЬ(УТП): способ резерва — колонка "Размещение"/"СпособОбеспечения"
		// в ТЧ Товары или флаг АвтоРезервирование в шапке. Заполнить по правилам базы.
		Попытка
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ВызватьБизнесОшибку("POSTING_ERROR",
				"Ошибка проведения заказа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Ложь);
		КонецПопытки;
	КонецЕсли;

	Возврат ОстаткиПоЗаказу(ЗаказСсылка);
КонецФункции

Функция ОперацияСнятьРезерв(Аргументы)
	ЗаказId = Формат(ЗначениеАргумента(Аргументы, "keycrmOrderId", 0), "ЧГ=0");
	ЗаказСсылка = НайтиПоВнешнемуИД("order", ЗаказId);
	Если ЗаказСсылка = Неопределено Тогда
		Возврат Ложь; // нечего снимать — идемпотентно
	КонецЕсли;
	Док = ЗаказСсылка.ПолучитьОбъект();
	Если НЕ Док.Проведен Тогда
		Возврат Истина; // уже снят — идемпотентно
	КонецЕсли;
	Попытка
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение
		ВызватьБизнесОшибку("POSTING_ERROR",
			"Ошибка отмены проведения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Ложь);
	КонецПопытки;
	Возврат Истина;
КонецФункции

Функция ОперацияРеализация(Аргументы)
	ЗаказId = Формат(ЗначениеАргумента(Аргументы, "keycrmOrderId", 0), "ЧГ=0");
	Чексумма = ЗначениеАргумента(Аргументы, "itemsChecksum", "");
	DryRun = ЗначениеАргумента(Аргументы, "dryRun", Ложь);

	ЗаказСсылка = НайтиПоВнешнемуИД("order", ЗаказId);
	Если ЗаказСсылка = Неопределено Тогда
		ВызватьБизнесОшибку("ORDER_NOT_FOUND", "Заказ KeyCRM #" + ЗаказId + " не найден", Ложь);
	КонецЕсли;

	// Идемпотентность: реализация уже создана — вернуть её, второго списания нет.
	СуществующаяРеализация = НайтиПоВнешнемуИД("ship", ЗаказId);
	Если СуществующаяРеализация <> Неопределено Тогда
		Возврат ОписаниеДокумента(СуществующаяРеализация);
	КонецЕсли;

	// Контроль неизменности состава с момента резерва.
	СохранённаяЧексумма = ПрочитатьВнешнееЗначение("order_checksum", ЗаказId);
	Если СохранённаяЧексумма <> Неопределено И СохранённаяЧексумма <> Чексумма Тогда
		ВызватьБизнесОшибку("ORDER_MODIFIED", "Состав заказа изменился после резерва", Ложь);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Реализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Реализация.Дата = ТекущаяДата();
		Реализация.Заполнить(ЗаказСсылка); // типовой механизм "на основании"
		// ПРОВЕРИТЬ(УТП): вид операции реализации (ПродажаКомиссия/Товары),
		// корректность заполнения Склада и ТЧ из заказа.
		Реализация.Комментарий = "KeyCRM #" + ЗаказId + " (автоматически)";

		Если DryRun Тогда
			ОтменитьТранзакцию();
			Возврат ОписаниеДокументаБезЗаписи(Реализация);
		КонецЕсли;

		Попытка
			Реализация.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ТекстОш = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Если СтрНайти(НРег(ТекстОш), "период") > 0 Тогда
				ВызватьБизнесОшибку("PERIOD_CLOSED", ТекстОш, Ложь);
			КонецЕсли;
			ВызватьБизнесОшибку("POSTING_ERROR", ТекстОш, Ложь);
		КонецПопытки;

		ЗаписатьВнешнийИД("ship", ЗаказId, Реализация.Ссылка);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Возврат ОписаниеДокумента(Реализация.Ссылка);
КонецФункции

Функция ОперацияВозврат(Аргументы)
	Запрос = ЗначениеАргумента(Аргументы, "request", Неопределено);
	DryRun = ЗначениеАргумента(Аргументы, "dryRun", Ложь);
	ЗаказId = Формат(ЗначениеАргумента(Запрос, "keycrmOrderId", 0), "ЧГ=0");

	РеализацияСсылка = НайтиПоВнешнемуИД("ship", ЗаказId);
	Если РеализацияСсылка = Неопределено Тогда
		ВызватьБизнесОшибку("ORDER_NOT_FOUND", "Реализация по заказу KeyCRM #" + ЗаказId + " не найдена", Ложь);
	КонецЕсли;

	// Исходная реализация НЕ удаляется и НЕ распроводится (ТЗ п.13).
	Возвр = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
	Возвр.Дата = ТекущаяДата();
	Возвр.Заполнить(РеализацияСсылка); // на основании реализации
	// ПРОВЕРИТЬ(УТП): корректность заполнения возврата на основании.
	Возвр.Комментарий = "KeyCRM #" + ЗаказId + " возврат: " + ЗначениеАргумента(Запрос, "reason", "");

	// Частичный возврат: оставить только запрошенные позиции/количества.
	ПозицииВозврата = ЗначениеАргумента(Запрос, "items", Новый Массив);
	Если НЕ ЗначениеАргумента(Запрос, "fullReturn", Ложь) Тогда
		СократитьТЧВозврата(Возвр, ПозицииВозврата);
	КонецЕсли;

	Если DryRun Тогда
		Возврат ОписаниеДокументаБезЗаписи(Возвр);
	КонецЕсли;

	Попытка
		Возвр.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ВызватьБизнесОшибку("POSTING_ERROR",
			"Ошибка проведения возврата: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Ложь);
	КонецПопытки;

	Возврат ОписаниеДокумента(Возвр.Ссылка);
КонецФункции

Функция ОперацияОплата(Аргументы)
	Запрос = ЗначениеАргумента(Аргументы, "request", Неопределено);
	DryRun = ЗначениеАргумента(Аргументы, "dryRun", Ложь);
	ОплатаId = Формат(ЗначениеАргумента(Запрос, "keycrmPaymentId", 0), "ЧГ=0");
	ЗаказId = Формат(ЗначениеАргумента(Запрос, "keycrmOrderId", 0), "ЧГ=0");
	Валюта = ЗначениеАргумента(Запрос, "currency", "");

	Если Валюта <> "USD" Тогда
		ВызватьБизнесОшибку("CURRENCY_NOT_SUPPORTED", "Валюта " + Валюта + " не поддерживается", Ложь);
	КонецЕсли;

	// Идемпотентность по keycrm_payment_id.
	Существующий = НайтиПоВнешнемуИД("payment", ОплатаId);
	Если Существующий <> Неопределено Тогда
		Возврат ОписаниеДокумента(Существующий);
	КонецЕсли;

	ЗаказСсылка = НайтиПоВнешнемуИД("order", ЗаказId);
	Если ЗаказСсылка = Неопределено Тогда
		ВызватьБизнесОшибку("ORDER_NOT_FOUND", "Заказ KeyCRM #" + ЗаказId + " не найден", Ложь);
	КонецЕсли;

	ПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	ПКО.Дата = ТекущаяДата();
	// ПРОВЕРИТЬ(УТП): ВидОперации (ОплатаПокупателя), Касса, ВалютаДокумента,
	// табличная часть РасшифровкаПлатежа (Договор, Сделка=Заказ, СуммаПлатежа).
	// Метод оплаты KeyCRM -> тип документа (ПКО/банк) — по mapping-таблице сервиса;
	// безнал реализуется отдельной операцией на Этапе 6.
	ПКО.СуммаДокумента = ЗначениеАргумента(Запрос, "amount", 0);
	ПКО.Комментарий = "KeyCRM оплата #" + ОплатаId + " по заказу #" + ЗаказId;

	Если DryRun Тогда
		Возврат ОписаниеДокументаБезЗаписи(ПКО);
	КонецЕсли;

	Попытка
		ПКО.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ВызватьБизнесОшибку("POSTING_ERROR",
			"Ошибка проведения оплаты: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Ложь);
	КонецПопытки;

	ЗаписатьВнешнийИД("payment", ОплатаId, ПКО.Ссылка);
	Возврат ОписаниеДокумента(ПКО.Ссылка);
КонецФункции

Функция ОперацияСостояниеЗаказа(Аргументы)
	ЗаказId = Формат(ЗначениеАргумента(Аргументы, "keycrmOrderId", 0), "ЧГ=0");
	Ответ = Новый Структура;

	ЗаказСсылка = НайтиПоВнешнемуИД("order", ЗаказId);
	Ответ.Вставить("order", ?(ЗаказСсылка = Неопределено, Неопределено, ОписаниеДокумента(ЗаказСсылка)));

	РезервАктивен = Ложь;
	РезервКоличество = 0;
	Если ЗаказСсылка <> Неопределено И ЗаказСсылка.Проведен Тогда
		Остатки = ОстаткиПоЗаказу(ЗаказСсылка);
		Для Каждого Ряд Из Остатки Цикл
			РезервКоличество = РезервКоличество + Ряд.reserved;
		КонецЦикла;
		РезервАктивен = РезервКоличество > 0;
	КонецЕсли;
	СостояниеРезерва = Новый Структура;
	СостояниеРезерва.Вставить("active", РезервАктивен);
	СостояниеРезерва.Вставить("quantityTotal", РезервКоличество);
	Ответ.Вставить("reserve", СостояниеРезерва);

	РеализацияСсылка = НайтиПоВнешнемуИД("ship", ЗаказId);
	Ответ.Вставить("realization", ?(РеализацияСсылка = Неопределено, Неопределено, ОписаниеДокумента(РеализацияСсылка)));
	Ответ.Вставить("returns", Новый Массив);   // TODO Этап 6: список возвратов
	Ответ.Вставить("payments", Новый Массив);  // TODO Этап 6: список оплат
	Возврат Ответ;
КонецФункции

Функция ОперацияПеремещения(Аргументы)
	СДаты = ДатаИзISO(ЗначениеАргумента(Аргументы, "since", ""));
	Массив = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СДаты", СДаты);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пер.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК Пер
	|ГДЕ
	|	Пер.Проведен И Пер.Дата >= &СДаты";
	// ПРОВЕРИТЬ(УТП): имя документа перемещения и реквизиты складов
	// (СкладОтправитель/СкладПолучатель).

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Ссылка;
		Пер = Новый Структура;
		Пер.Вставить("guid", XMLСтрока(Док.УникальныйИдентификатор()));
		Пер.Вставить("number", СокрЛП(Док.Номер));
		Пер.Вставить("date", ФорматДатыISO(Док.Дата));
		Пер.Вставить("warehouseFromGuid", XMLСтрока(Док.СкладОтправитель.УникальныйИдентификатор()));
		Пер.Вставить("warehouseToGuid", XMLСтрока(Док.СкладПолучатель.УникальныйИдентификатор()));
		ПозицииПер = Новый Массив;
		Для Каждого СтрокаТЧ Из Док.Товары Цикл
			Хар = Неопределено;
			// ПРОВЕРИТЬ(УТП): имя колонки характеристики в ТЧ перемещения.
			Поз = Новый Структура;
			Поз.Вставить("sku", SKUПоНоменклатуре(СтрокаТЧ.Номенклатура, Хар));
			Поз.Вставить("quantity", СтрокаТЧ.Количество);
			ПозицииПер.Добавить(Поз);
		КонецЦикла;
		Пер.Вставить("items", ПозицииПер);
		Массив.Добавить(Пер);
	КонецЦикла;
	Возврат Массив;
КонецФункции

#КонецОбласти

#Область ВнешниеИдентификаторы
// Хранение соответствий "сущность KeyCRM -> ссылка 1С" через типовой механизм
// свойств (БЕЗ изменения конфигурации):
//   ПланВидовХарактеристик.СвойстваОбъектов + РегистрСведений.ЗначенияСвойствОбъектов.
// Для каждого вида создаётся свойство "KeyCRM_<вид>" (buyer/order/ship/payment/...).
// ПРОВЕРИТЬ(УТП): точные имена плана видов характеристик и регистра.

Функция СвойствоKeyCRM(Вид)
	ИмяСвойства = "KeyCRM_" + Вид;
	Найдено = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(ИмяСвойства, Истина);
	Если ЗначениеЗаполнено(Найдено) Тогда
		Возврат Найдено;
	КонецЕсли;
	// Автосоздание свойства при первом использовании.
	Новое = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
	Новое.Наименование = ИмяСвойства;
	// ПРОВЕРИТЬ(УТП): назначение свойства (НазначениеСвойствКатегорийОбъектов) и
	// ТипЗначения = Строка — задать по правилам базы.
	Новое.Записать();
	Возврат Новое.Ссылка;
КонецФункции

Функция НайтиПоВнешнемуИД(Вид, Идентификатор)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", СвойствоKeyCRM(Вид));
	Запрос.УстановитьПараметр("Значение", Идентификатор);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Значения.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
	|ГДЕ
	|	Значения.Свойство = &Свойство И Значения.Значение = &Значение";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Объект;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ЗаписатьВнешнийИД(Вид, Идентификатор, Объект)
	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Объект);
	Набор.Отбор.Свойство.Установить(СвойствоKeyCRM(Вид));
	Запись = Набор.Добавить();
	Запись.Объект = Объект;
	Запись.Свойство = СвойствоKeyCRM(Вид);
	Запись.Значение = Идентификатор;
	Набор.Записать(Истина);
КонецПроцедуры

Функция ПрочитатьВнешнееЗначение(Вид, КлючОбъекта)
	// Для служебных значений (чексумма состава) объект = заказ, значение = строка.
	ЗаказСсылка = НайтиПоВнешнемуИД("order", КлючОбъекта);
	Если ЗаказСсылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", ЗаказСсылка);
	Запрос.УстановитьПараметр("Свойство", СвойствоKeyCRM(Вид));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Значения.Значение КАК Значение
	|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Значения
	|ГДЕ Значения.Объект = &Объект И Значения.Свойство = &Свойство";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция БылаРеализация(ЗаказId)
	Возврат НайтиПоВнешнемуИД("ship", ЗаказId) <> Неопределено;
КонецФункции

